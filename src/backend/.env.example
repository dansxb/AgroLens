# =============================================================
# AgroLens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# -------------------------------------------------------------
# Database
# Full PostgreSQL+PostGIS connection string.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# For synchronous Alembic use: postgresql://user:password@host:port/dbname
# Obtain: create a local or RDS PostgreSQL instance with PostGIS.
# Required: yes
# -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agrolens:your_strong_postgres_password_here@localhost:5432/agrolens_dev

# Used by Alembic (sync driver) — mirrors DATABASE_URL but uses psycopg2
DATABASE_SYNC_URL=postgresql://agrolens:your_strong_postgres_password_here@localhost:5432/agrolens_dev

# -------------------------------------------------------------
# FastAPI Application Secret
# Used for signing internal tokens and CSRF protection.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required: yes
# -------------------------------------------------------------
SECRET_KEY=replace_me_with_a_64_char_random_hex_string_00000000000000000000

# -------------------------------------------------------------
# Supabase
# Obtain all three values from your Supabase project dashboard
# under Settings → API.
# Required: yes
# -------------------------------------------------------------

# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — grants admin access; NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret from Supabase dashboard → Settings → API → JWT Secret
# Used to verify Supabase-issued JWTs on the backend
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# -------------------------------------------------------------
# Sentinel Hub (Copernicus satellite imagery)
# Obtain from: https://apps.sentinel-hub.com/dashboard/
# Required: yes (for imagery pipeline)
# -------------------------------------------------------------

# OAuth2 client ID for Sentinel Hub service account
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here

# OAuth2 client secret for Sentinel Hub service account
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# Sentinel Hub configuration/instance ID (from your SH dashboard)
SENTINEL_HUB_INSTANCE_ID=your_sentinel_hub_instance_id_here

# -------------------------------------------------------------
# AWS (S3 for imagery and export storage)
# Use an IAM user with minimal S3 permissions (PutObject, GetObject, DeleteObject)
# on the specific bucket only.
# Data residency: use eu-west-1 or eu-central-1 for EU customer data.
# Required: yes (for pipeline and exports)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=agrolens-imagery-dev
AWS_S3_REGION=eu-central-1

# -------------------------------------------------------------
# Stripe (Subscription Billing)
# Obtain from https://dashboard.stripe.com/apikeys
# Use sk_test_* keys for development, sk_live_* for production.
# Required: yes (for billing features)
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me_with_your_stripe_secret_key

# Webhook signing secret from Stripe Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace_me_with_your_webhook_signing_secret

# Price IDs from Stripe Dashboard → Products
# Starter plan: €49/month
STRIPE_PRICE_ID_STARTER_MONTHLY=price_replace_me_starter_monthly

# Starter plan: €470/year (20% discount)
STRIPE_PRICE_ID_STARTER_ANNUAL=price_replace_me_starter_annual

# Farmer plan: €199/month
STRIPE_PRICE_ID_FARMER_MONTHLY=price_replace_me_farmer_monthly

# Farmer plan: €1,910/year (20% discount)
STRIPE_PRICE_ID_FARMER_ANNUAL=price_replace_me_farmer_annual

# Pro plan: €599/month
STRIPE_PRICE_ID_PRO_MONTHLY=price_replace_me_pro_monthly

# Pro plan: €5,750/year (20% discount)
STRIPE_PRICE_ID_PRO_ANNUAL=price_replace_me_pro_annual

# -------------------------------------------------------------
# SendGrid (Transactional Email)
# Obtain from https://app.sendgrid.com/settings/api_keys
# Required: yes (for notifications)
# -------------------------------------------------------------
SENDGRID_API_KEY=SG.replace_me_with_your_sendgrid_api_key

# Verified sender email address in SendGrid
SENDGRID_FROM_EMAIL=noreply@agrolens.io

# -------------------------------------------------------------
# Application Runtime
# -------------------------------------------------------------

# One of: development | staging | production
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
# Example production: https://app.agrolens.io,https://www.agrolens.io
# In development: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Python logging level. One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# -------------------------------------------------------------
# Celery (Background Task Queue)
# Redis is used as both broker and result backend.
# -------------------------------------------------------------

# Celery broker URL — Redis instance (use redis://:password@host:port/db)
CELERY_BROKER_URL=redis://:your_redis_password_here@localhost:6379/0

# Celery result backend URL — same Redis instance, different DB index
CELERY_RESULT_BACKEND=redis://:your_redis_password_here@localhost:6379/1

# -------------------------------------------------------------
# Sentry (Error Tracking)
# Obtain from https://sentry.io — create a Python/FastAPI project
# Optional in development; required in staging/production
# -------------------------------------------------------------
SENTRY_DSN=https://your_sentry_public_key@o000000.ingest.sentry.io/0000000

# Shared secret for the /monitoring/pipeline-health internal endpoint
MONITOR_SECRET_KEY=replace_me_with_a_random_monitor_secret_key
