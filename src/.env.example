# =============================================================
# AgroLens — Root docker-compose Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# -------------------------------------------------------------
# PostgreSQL (PostGIS)
# Used by docker-compose to initialise the postgres container
# and by the backend DATABASE_URL below.
# -------------------------------------------------------------

# Database superuser username
POSTGRES_USER=agrolens

# Database superuser password — use a strong random value
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Database name created on first container start
POSTGRES_DB=agrolens_dev

# -------------------------------------------------------------
# Redis
# Used as Celery broker and result backend
# -------------------------------------------------------------

# Redis password (leave empty string for no password in local dev)
REDIS_PASSWORD=your_redis_password_here
