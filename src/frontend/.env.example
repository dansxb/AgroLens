# =============================================================
# AgroLens Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# NEXT_PUBLIC_* variables are exposed to the browser bundle —
# never put secrets in NEXT_PUBLIC_ variables.
# =============================================================

# -------------------------------------------------------------
# Backend API
# Base URL of the FastAPI backend (no trailing slash).
# In development: http://localhost:8000
# In production: https://api.agrolens.io
# Required: yes
# -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------
# Supabase
# Obtain from your Supabase project dashboard under Settings → API.
# These are safe to expose in the browser (anon key is public by design).
# Required: yes
# -------------------------------------------------------------

# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — controls access via Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -------------------------------------------------------------
# Mapbox
# Obtain from https://account.mapbox.com/access-tokens/
# Restrict token to specific URLs in production.
# Required: yes (for map rendering)
# -------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me_with_your_mapbox_public_token

# -------------------------------------------------------------
# Stripe
# Publishable key from https://dashboard.stripe.com/apikeys
# Safe to expose in browser (publishable key only).
# Required: yes (for billing UI)
# -------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me_with_your_stripe_publishable_key

# -------------------------------------------------------------
# Sentry (Frontend Error Tracking)
# Obtain from https://sentry.io — create a Next.js project.
# Optional in development; required in staging/production.
# -------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your_frontend_sentry_key@o000000.ingest.sentry.io/0000001

# -------------------------------------------------------------
# Environment
# One of: development | staging | production
# Controls Sentry initialisation and other environment-specific behaviour.
# Required: yes
# -------------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT=development
